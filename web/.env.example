# Test Flight — connector credentials (server-side only, never committed).
# Copy to .env for `vercel dev`, or add each key in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# Leave a connector's variables unset to keep it on the synthetic dataset.
# See docs/connectors.md for how to obtain each value.

# Zoom — Server-to-Server OAuth app (marketplace.zoom.us)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Slack — bot token with channels:history (api.slack.com/apps)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Gmail — OAuth refresh token, scope gmail.readonly
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Zendesk — API token
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Intercom — access token
INTERCOM_ACCESS_TOKEN=

# App Store reviews — public RSS, numeric app id only
APPSTORE_APP_ID=
APPSTORE_COUNTRY=us

# Salesforce — Connected App (adapter stub, optional)
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REFRESH_TOKEN=

# Grounded chat provider (server-only). DISABLED until all three are set.
# CHAT_PROVIDER: openai | anthropic | openrouter | sciforium | deepseek
# Endpoint host must be allowlisted (see api/_lib/chat/provider.js).
# No provider is called and no credits are spent until you pick one.
CHAT_PROVIDER=
CHAT_MODEL=
CHAT_API_KEY=
# Optional override (host must be allowlisted)
CHAT_BASE_URL=
# Optional caps (defaults shown)
CHAT_MAX_MESSAGE_CHARS=1000
CHAT_MAX_CONTEXT_DOCS=6
CHAT_MAX_DOC_CHARS=600
CHAT_MAX_OUTPUT_TOKENS=500
CHAT_RATE_MAX=12
CHAT_RATE_WINDOW_MS=60000