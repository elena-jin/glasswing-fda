# Test Flight — connector credentials (server-side only, never committed).
# Copy to .env for `vercel dev`, or add each key in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# Leave a connector's variables unset to keep it on the synthetic dataset.
# See docs/connectors.md for how to obtain each value.

# Zoom — Server-to-Server OAuth app (marketplace.zoom.us)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Slack — bot token with channels:history (api.slack.com/apps)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Gmail — OAuth refresh token, scope gmail.readonly
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Zendesk — API token
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Intercom — access token
INTERCOM_ACCESS_TOKEN=

# App Store reviews — public RSS, numeric app id only
APPSTORE_APP_ID=
APPSTORE_COUNTRY=us

# Salesforce — Connected App (adapter stub, optional)
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REFRESH_TOKEN=

# Optional: proxy /api/assistant to the real retrieval backend in repo `assistant/`
ASSISTANT_API_URL=
ASSISTANT_API_KEY=