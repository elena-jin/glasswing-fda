# Braintrust dev evals — grounded Test Flight assistant
#
# GATED: nothing runs unless BRAINTRUST_ENABLE=1 AND BRAINTRUST_API_KEY are set.
# Never commit this file with values. Server-side only; no keys in the web app.

# Explicit opt-in (set to 1 to allow eval runs / tracing)
BRAINTRUST_ENABLE=

# Braintrust key — https://www.braintrust.dev/app/Hackathon%20Team%201/p/My%20Project
BRAINTRUST_API_KEY=

# Optional: Braintrust project/experiment overrides
BRAINTRUST_PROJECT=My Project
BRAINTRUST_EXPERIMENT=grounded-assistant-synthetic

# The assistant endpoint under test (deployed preview or local `vercel dev`)
ASSISTANT_URL=https://test-flight-console-pearl.vercel.app

# Optional internal token (only if the deployment requires it for /api/assistant)
TF_INTERNAL_TOKEN=

# By default traces are metadata-only. Set to 1 ONLY if you accept logging
# sanitized reply text (never raw prompts or retrieved source text).
BRAINTRUST_LOG_CONTENT=

# Comma-separated deny-list prefixes for the no-real-source scorer (defence in depth)
HOLDOUT_DENY_PREFIXES=locked,maude,real-